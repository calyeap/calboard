# Copy this file to .env.local and fill in real values.
# See README.md ("Setup") for what each variable does and when it's required.

# Postgres connection string. Matches docker-compose.yml's default local credentials.
DATABASE_URL=postgres://calboard:calboard_dev_local_only@127.0.0.1:5432/calboard

# A separate database for integration tests. The name MUST end in `_test` —
# vitest.setup.ts refuses to run otherwise, since tests TRUNCATE tables between
# runs and this is the guard against wiping your real portfolio data.
TEST_DATABASE_URL=postgres://calboard:calboard_dev_local_only@127.0.0.1:5432/calboard_test

# Which MarketDataProvider adapter to use: YAHOO or EODHD. Defaults to YAHOO
# (no key required) if unset.
# MARKET_DATA_PROVIDER=YAHOO

# Only required when MARKET_DATA_PROVIDER=EODHD.
EODHD_API_KEY=

# Reserved for future milestones — not read by the current build.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
RENDER_API_KEY=
